# Credenciais Seguras do Banco de Dados
POSTGRES_USER="seu_usuario_aqui"
POSTGRES_PASSWORD="sua_senha_super_secreta"
POSTGRES_DB="salgado_care"

# String de conexão (usada para rodar scripts ou se conectar externamente via porta 7003)
# Lembre-se de substituir 'seu_usuario_aqui' e 'sua_senha_super_secreta' pelos mesmos valores configurados acima.
DATABASE_URL="postgres://seu_usuario_aqui:sua_senha_super_secreta@localhost:7003/salgado_care"

# Porta do servidor da API REST
PORT=7002

# URL do Frontend autorizada no CORS (🚨 IMPORTANTE: Substitua pelo domínio real do seu site ou IP da VPS)
# FRONTEND_URL="https://app.salgadocare.com.br"
FRONTEND_URL="http://localhost:7001"

# Chave secreta gerada de forma segura para os tokens de autenticação (JWT)
JWT_SECRET="sua_chave_secreta_jwt_aqui"
